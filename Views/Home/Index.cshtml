@using banthietbidientu.Data
@using banthietbidientu.Models
@inject ApplicationDbContext _context
@{
    ViewData["Title"] = "Trang chủ - SmartTech";
    var cultureInfo = new System.Globalization.CultureInfo("vi-VN");

    // Lấy danh sách Banner đang hoạt động từ CSDL, sắp xếp theo thứ tự hiển thị
    var listBanners = _context.Banners
                        .Where(b => b.IsActive)
                        .OrderBy(b => b.DisplayOrder)
                        .ToList();
}
@model IEnumerable<banthietbidientu.Models.SanPham>

@section Styles {
    <style>
        /* 1. Fix lỗi Toast và Modal bị che khuất */
        .toast-container {
            z-index: 100000 !important;
            top: 100px !important;
        }

        /* Đảm bảo Modal luôn nổi lên trên cùng */
        .modal {
            z-index: 100050 !important;
        }
        /* Lớp đen mờ phải nằm dưới Modal */
        .modal-backdrop {
            z-index: 100040 !important;
        }

        /* 2. CSS CAROUSEL BANNER MỚI (Apple Style) */
        .carousel-banner-wrapper {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1rem;
        }

        .carousel-banner-inner {
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.1);
        }

        .carousel-item {
            height: 480px;
            background-color: #0b0f19;
            position: relative;
        }

            .carousel-item img {
                object-fit: cover;
                height: 100%;
                width: 100%;
                opacity: 0.85;
                filter: brightness(0.95);
            }

        .carousel-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, rgba(11, 15, 25, 0.85) 0%, rgba(11, 15, 25, 0.4) 60%, rgba(11, 15, 25, 0) 100%);
        }

        .carousel-caption-glass {
            position: absolute;
            bottom: 50%;
            transform: translateY(50%);
            left: 5%;
            z-index: 2;
            max-width: 580px;
            text-align: left;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 2.25rem 2.5rem;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
        }

            .carousel-caption-glass h1 {
                font-weight: 800;
                font-size: 2.5rem;
                letter-spacing: -0.02em;
                margin-bottom: 0.75rem;
                line-height: 1.15;
                color: #ffffff;
            }

            .carousel-caption-glass p {
                font-size: 1.05rem;
                font-weight: 400;
                margin-bottom: 1.5rem;
                color: #e2e8f0;
                line-height: 1.5;
            }

        .btn-hero {
            background: #ffffff;
            color: #0f172a !important;
            padding: 0.75rem 2rem;
            font-weight: 700;
            border-radius: 999px;
            font-size: 0.95rem;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(0,0,0,0.15);
        }

            .btn-hero:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(255,255,255,0.3);
                background: #f8fafc;
                color: #000000 !important;
            }

        /* 3. CSS Product Card */
        .product-card-hover {
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            border: 1px solid rgba(15, 23, 42, 0.08);
            border-radius: 20px;
            overflow: hidden;
            background: #ffffff;
            position: relative;
            z-index: 1;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        }

            .product-card-hover:hover {
                transform: translateY(-5px);
                box-shadow: 0 16px 32px -8px rgba(15, 23, 42, 0.1) !important;
                border-color: rgba(15, 23, 42, 0.16);
                z-index: 10;
            }

        .product-img-container {
            height: 230px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8fafc;
            padding: 24px;
            position: relative;
        }

            .product-img-container img {
                max-height: 100%;
                max-width: 100%;
                object-fit: contain;
                transition: transform 0.4s ease;
            }

        .product-card-hover:hover .product-img-container img {
            transform: scale(1.06);
        }

        .badge-overlay {
            position: absolute;
            top: 12px;
            right: 12px;
            z-index: 5;
        }

        /* 4. CSS cho Modal Chọn Loại */
        .option-btn {
            border: 1px solid #dee2e6;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            background: #fff;
            min-width: 80px;
            text-align: center;
            user-select: none;
        }

            .option-btn:hover {
                border-color: #0d6efd;
                background: #f8f9fa;
            }

            .option-btn.active {
                border-color: #0d6efd;
                background-color: #e7f1ff;
                color: #0d6efd;
                font-weight: bold;
                box-shadow: 0 0 0 1px #0d6efd;
            }

        .color-btn {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid #dee2e6;
            position: relative;
            transition: transform 0.2s;
        }

            .color-btn:hover {
                transform: scale(1.1);
            }

            .color-btn.active {
                border-color: #0d6efd;
                transform: scale(1.1);
                box-shadow: 0 0 5px rgba(0,0,0,0.3);
            }

                .color-btn.active::after {
                    content: '\F26E';
                    font-family: "bootstrap-icons";
                    color: white;
                    font-size: 12px;
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    text-shadow: 0 0 2px rgba(0,0,0,0.5);
                }

        .card-actions {
            position: relative;
            z-index: 20;
        }

        .stretched-link {
            z-index: 2;
        }

        /* Custom Controls Carousel */
        .carousel-control-prev, .carousel-control-next {
            width: 5%;
            opacity: 0.7;
            z-index: 5;
        }

            .carousel-control-prev:hover, .carousel-control-next:hover {
                opacity: 1;
            }
    </style>
}

<div class="carousel-banner-wrapper my-4">
    <div id="smartTechCarousel" class="carousel slide carousel-fade carousel-banner-inner" data-bs-ride="carousel" data-bs-interval="6000">

        <div class="carousel-indicators mb-3">
            @if (listBanners != null && listBanners.Any())
            {
                for (int i = 0; i < listBanners.Count; i++)
                {
                    <button type="button" data-bs-target="#smartTechCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "") rounded-pill" style="width: 28px; height: 4px;"></button>
                }
            }
        </div>

        <div class="carousel-inner">
            @if (listBanners != null && listBanners.Any())
            {
                for (int i = 0; i < listBanners.Count; i++)
                {
                    var banner = listBanners[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@banner.ImageUrl" alt="@banner.Title">
                        <div class="carousel-overlay"></div>

                        <div class="carousel-caption-glass">
                            <span class="badge bg-white text-dark rounded-pill px-3 py-2 fw-bold text-uppercase mb-3" style="font-size: 0.72rem; letter-spacing: 0.05em;">SmartTech Special</span>
                            <h1>@banner.Title</h1>
                            @if (!string.IsNullOrEmpty(banner.Description))
                            {
                                <p>@banner.Description</p>
                            }
                            <a href="@(string.IsNullOrEmpty(banner.LinkUrl) ? "#products" : banner.LinkUrl)"
                               class="btn-hero">
                                <span>@(string.IsNullOrEmpty(banner.ButtonText) ? "Khám phá ngay" : banner.ButtonText)</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="carousel-item active">
                    <img src="https://via.placeholder.com/1600x600?text=SmartTech+Flagship" alt="Default">
                    <div class="carousel-overlay"></div>
                    <div class="carousel-caption-glass">
                        <span class="badge bg-white text-dark rounded-pill px-3 py-2 fw-bold text-uppercase mb-3" style="font-size: 0.72rem;">SmartTech Store</span>
                        <h1>Trải nghiệm công nghệ đỉnh cao</h1>
                        <p>Hệ thống phân phối thiết bị điện tử chính hãng với ưu đãi đặc quyền.</p>
                        <a href="#products" class="btn-hero">
                            <span>Khám phá ngay</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#smartTechCarousel" data-bs-slide="prev" aria-label="Previous">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#smartTechCarousel" data-bs-slide="next" aria-label="Next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>
</div>

<!-- 4 Value Props (Apple Style) -->
