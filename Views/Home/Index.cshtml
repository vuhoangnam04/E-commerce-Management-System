<div class="container my-5" id="products">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 pb-2 border-bottom">
        <div>
            <span class="text-uppercase fw-bold text-primary small" style="letter-spacing: 0.08em; font-size: 0.75rem;">Sản phẩm nổi bật</span>
            <h2 class="fw-bold text-dark m-0" style="letter-spacing: -0.02em;">Danh mục thiết bị</h2>
        </div>

        <div class="dropdown mt-2 mt-sm-0">
            <button class="btn btn-sleek-outline btn-sm py-2 px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-filter me-1"></i> Sắp xếp theo
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="#">Giá tăng dần</a></li>
                <li><a class="dropdown-item" href="#">Giá giảm dần</a></li>
                <li><a class="dropdown-item" href="#">Mới nhất</a></li>
            </ul>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">Hiện chưa có sản phẩm nào!</p>
            </div>
        }
        else
        {
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100 product-card-hover">
                        <div class="badge-overlay">
                            @if (product.SoLuong < 1)
                            {
                                <span class="badge-sleek-stock out-of-stock">Hết hàng</span>
                            }
                            else
                            {
                                <span class="badge-sleek-stock"><i class="bi bi-check-circle-fill"></i> Còn hàng</span>
                            }
                        </div>

                        <div class="product-img-container">
                            <img src="@(product.ImageUrl ?? "/images/default-product.png")"
                                 alt="@product.Name"
                                 onerror="this.src='/image/logo.png'">
                        </div>

                        <div class="card-body p-4 d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge-sleek-category">@product.Category</span>
                            </div>

                            <h5 class="card-title text-truncate mb-3" title="@product.Name" style="position: relative; z-index: 5; font-size: 1rem; font-weight: 700;">
                                <a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.Id })" class="text-decoration-none text-dark">@product.Name</a>
                            </h5>

                            <div class="mt-auto">
                                <div class="mb-3">
                                    <span class="fs-5 fw-bold" style="color: #0f172a; letter-spacing: -0.01em;">@product.Price.ToString("N0", cultureInfo) ₫</span>
                                </div>

                                <div class="card-actions" style="position: relative; z-index: 20;">
                                    @if (product.SoLuong > 0)
                                    {
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <button type="button" class="btn btn-sleek-soft w-100 py-2 position-relative"
                                                        style="z-index: 100; font-size: 0.82rem;"
                                                        title="Chọn tùy chọn và thêm vào giỏ"
                                                        onclick="event.stopPropagation(); openOptionModal(@product.Id, '@product.Name', @product.Price, '@(product.ImageUrl ?? "/images/default.jpg")', '@product.Category')">
                                                    <i class="bi bi-cart-plus"></i> Thêm giỏ
                                                </button>
                                            </div>
                                            <div class="col-6">
                                                <a href="@Url.Action("MuaNgay", "GioHang", new { id = product.Id })"
                                                   class="btn btn-sleek-primary w-100 py-2 position-relative text-decoration-none d-flex align-items-center justify-content-center"
                                                   style="z-index: 100; font-size: 0.82rem;"
                                                   title="Mua ngay và thanh toán">
                                                    <i class="bi bi-lightning-fill text-warning"></i> Mua ngay
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary w-100 rounded-pill py-2 text-muted" style="font-size: 0.85rem;" disabled>Tạm hết hàng</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
                <div>
                    <h6 class="fw-bold mb-1">Hỗ trợ 24/7</h6>
                    <small class="text-muted">Hotline: 0965.629.698</small>
                </div>
            </div>
