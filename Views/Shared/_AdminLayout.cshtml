@inject banthietbidientu.Services.MemberService MemberService

<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartTech Quản Trị Quy Trình</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 (Dark Theme enabled) & Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Modern Dark Admin Stylesheet -->
    <link rel="stylesheet" href="~/css/admin-dark.css" asp-append-version="true" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dark-theme">

    <div class="wrapper">
        <!-- Sidebar Navigation: Bao Quát Quy Trình Vận Hành -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <a href="@Url.Action("Index", "Admin")" class="d-flex align-items-center text-decoration-none">
                    <div class="brand-logo-icon">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                    <div>
                        <div class="brand-title">SmartTech</div>
                        <div class="brand-subtitle">Workflow Management Hub</div>
                    </div>
                </a>
            </div>

            <ul class="list-unstyled components">
                @{
                    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                    bool isBossSidebar = User.IsInRole("Boss");
                }

                <!-- TỔNG QUAN HỆ THỐNG -->
                <li class="nav-header-text">
                    <i class="bi bi-grid-1x2-fill text-primary"></i> Tổng quan quy trình
                </li>

                <li>
                    <a href="@Url.Action("Index", "Admin")" class="@(currentController == "Admin" && currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Bảng điều khiển quy trình
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("Kanban", "Admin")" class="@(currentController == "Admin" && currentAction == "Kanban" ? "active" : "")">
                        <i class="bi bi-diagram-3 text-warning"></i> Điều phối công việc
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("Index", "Chat")" class="@(currentController == "Chat" ? "active" : "")">
                        <i class="bi bi-chat-dots-fill"></i> Hỗ trợ khách hàng
                        <span class="badge-menu bg-primary text-white ms-auto">SignalR</span>
                    </a>
                </li>

                <!-- GIAI ĐOẠN 1: CUNG ỨNG & KHO HÀNG -->
                <li class="nav-header-text">
                    <i class="bi bi-boxes text-cyan"></i> 1. Cung ứng & Kho hàng
                </li>

                @if (isBoss)
                {
                    <li>
                        <a href="@Url.Action("NhapHang", "Warehouse")" class="@(currentController == "Warehouse" && currentAction == "NhapHang" ? "active" : "")">
                            <i class="bi bi-box-arrow-in-down text-success"></i> Nhập kho hàng mới
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("QuanLyNhapHang", "Warehouse")" class="@(currentController == "Warehouse" && currentAction == "QuanLyNhapHang" ? "active" : "")">
                            <i class="bi bi-journal-check"></i> Lịch sử nhập kho
                        </a>
                    </li>
                }

                <li>
                    <a href="@Url.Action("Index", "ProductManager")" class="@(currentController == "ProductManager" ? "active" : "")">
                        <i class="bi bi-box-seam-fill"></i> Tồn kho sản phẩm
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("QuanLyChuyenKho", "Warehouse")" class="@(currentController == "Warehouse" && (currentAction == "QuanLyChuyenKho" || currentAction == "TaoLenhChuyenKho") ? "active" : "")">
                        <i class="bi bi-truck-front-fill text-warning"></i> Điều phối kho 3 miền
                    </a>
                </li>

                <!-- GIAI ĐOẠN 2: BÁN HÀNG & GIAO NHẬN -->
                <li class="nav-header-text">
                    <i class="bi bi-cart-check-fill text-emerald"></i> 2. Bán hàng & Giao nhận
                </li>

                <li>
                    <a href="@Url.Action("QuanLyDonHang", "Admin")" class="@(currentController == "Admin" && currentAction == "QuanLyDonHang" ? "active" : "")">
                        <i class="bi bi-receipt-cutoff"></i> Quản lý đơn hàng
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("QuanLyThuMua", "Admin")" class="@(currentController == "Admin" && currentAction == "QuanLyThuMua" ? "active" : "")">
                        <i class="bi bi-phone-flip text-info"></i> Thu cũ đổi mới
                    </a>
                </li>

                @if (isBossSidebar)
                {
                    <li>
                        <a href="@Url.Action("QuanLyVoucher", "Admin")" class="@(currentController == "Admin" && currentAction == "QuanLyVoucher" ? "active" : "")">
                            <i class="bi bi-ticket-perforated-fill text-danger"></i> Voucher khuyến mãi
                        </a>
                    </li>

                    <li>
                        <a href="@Url.Action("QuanLyBanner", "Admin")" class="@(currentController == "Admin" && (currentAction == "QuanLyBanner" || currentAction == "ThemBanner" || currentAction == "SuaBanner") ? "active" : "")">
                            <i class="bi bi-images"></i> Quản lý Banner
                        </a>
                    </li>
                }

                <!-- GIAI ĐOẠN 3: NHÂN SỰ & KHÁCH HÀNG -->
                <li class="nav-header-text">
                    <i class="bi bi-people-fill text-purple"></i> 3. Nhân sự & Khách hàng
                </li>

                @if (isBoss)
                {
                    <li>
                        <a href="@Url.Action("QuanLyTaiKhoan", "Admin")" class="@(currentController == "Admin" && (currentAction == "QuanLyTaiKhoan" || currentAction == "ThemTaiKhoan" || currentAction == "SuaTaiKhoan") ? "active" : "")">
                            <i class="bi bi-person-gear"></i> Quản lý nhân sự & TK
                        </a>
                    </li>
                }

                <li>
                    <a href="@Url.Action("QuanLyDanhGia", "Admin")" class="@(currentController == "Admin" && currentAction == "QuanLyDanhGia" ? "active" : "")">
                        <i class="bi bi-star-fill text-warning"></i> Đánh giá phản hồi
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("QuanLyThongBao", "Admin")" class="@(currentController == "Admin" && currentAction == "QuanLyThongBao" ? "active" : "")">
                        <i class="bi bi-bell-fill"></i> Thông báo nội bộ
                    </a>
                </li>

                <!-- GIAI ĐOẠN 4: TÀI CHÍNH & VẬN HÀNH -->
                <li class="nav-header-text">
                    <i class="bi bi-graph-up-arrow text-rose"></i> 4. Tài chính & Vận hành
                </li>

                @if (isBossSidebar)
                {
                    <li>
                        <a href="@Url.Action("BaoCao", "Admin")" class="@(currentController == "Admin" && currentAction == "BaoCao" ? "active" : "")">
                            <i class="bi bi-pie-chart-fill"></i> Báo cáo doanh thu
                        </a>
                    </li>

                    <li>
                        <a href="@Url.Action("QuanLyLuong", "Admin")" class="@(currentController == "Admin" && currentAction == "QuanLyLuong" ? "active" : "")">
                            <i class="bi bi-cash-stack text-success"></i> Bảng lương & Thưởng
                        </a>
                    </li>

                    <li>
                        <a href="@Url.Action("QuanLyThue", "Admin")" class="@(currentController == "Admin" && currentAction == "QuanLyThue" ? "active" : "")">
                            <i class="bi bi-bank2 text-warning"></i> Kiểm soát Thuế (VAT)
                        </a>
                    </li>

                    <li>
                        <a href="@Url.Action("NhatKyHoatDong", "Admin")" class="@(currentController == "Admin" && currentAction == "NhatKyHoatDong" ? "active" : "")">
                            <i class="bi bi-journal-text"></i> Nhật ký hoạt động
                        </a>
                    </li>
                }

                @if (!isBossSidebar)
                {
                    <li>
                        <a href="@Url.Action("LuongCuaToi", "Admin")" class="@(currentController == "Admin" && currentAction == "LuongCuaToi" ? "active" : "")">
                            <i class="bi bi-wallet2 text-success"></i> Thu nhập của tôi
                        </a>
                    </li>
                }
            </ul>
        </nav>

        <!-- Main Content Area -->
        <div id="content">
            <!-- Modern Dark Topbar -->
            <nav class="admin-navbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" id="sidebarCollapse" class="btn btn-dark border border-secondary d-lg-none rounded-3 px-2 py-1">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    
                    <div class="admin-search-pill d-none d-md-flex">
                        <i class="bi bi-search text-muted"></i>
                        <input type="text" placeholder="Tìm đơn hàng, mã SP, nhân sự..." id="adminQuickSearch" />
                    </div>
                </div>

                <div class="d-flex align-items-center ms-auto gap-3">
                    <!-- Quick Storefront Link (Giao diện cơ bản) -->
                    <a href="/" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 d-none d-sm-inline-flex align-items-center gap-2" style="font-size: 0.82rem; font-weight: 600; border-color: rgba(255,255,255,0.2);">
                        <i class="bi bi-shop"></i>
                        <span>Cửa hàng bán lẻ</span>
                        <i class="bi bi-box-arrow-up-right small"></i>
                    </a>

                    <!-- Notification Bell Dropdown -->
                    <div class="dropdown">
                        <a href="#" class="position-relative d-flex align-items-center justify-content-center text-white rounded-circle" id="bellDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="width: 40px; height: 40px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255, 255, 255, 0.1);">
                            <i class="bi bi-bell fs-5"></i>
                            <span id="notif-badge" class="notification-pill-badge d-none">0</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="bellDropdown" style="width: 360px; max-height: 440px; overflow-y: auto; padding: 0 !important; background: #131d33; border: 1px solid rgba(255,255,255,0.12);">
                            <div class="p-3 border-bottom d-flex justify-content-between align-items-center sticky-top" style="border-radius: 14px 14px 0 0; background: #0f172a; border-color: rgba(255,255,255,0.08) !important;">
                                <div class="fw-bold text-white d-flex align-items-center gap-2">
                                    <i class="bi bi-bell-fill text-primary"></i>
                                    <span>Thông báo quy trình</span>
                                </div>
                                <a href="javascript:void(0)" onclick="danhDauDaDoc()" class="text-primary small fw-semibold text-decoration-none">Đọc tất cả</a>
                            </div>
                            <ul class="list-unstyled mb-0" id="notif-list">
                                <li class="text-center p-4 text-muted small">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    Đang kiểm tra...
                                </li>
                            </ul>
                            <div class="p-2 border-top text-center" style="border-radius: 0 0 14px 14px; background: #0f172a; border-color: rgba(255,255,255,0.08) !important;">
                                <a class="small text-primary fw-bold text-decoration-none" href="@Url.Action("QuanLyThongBao", "Admin")">Xem tất cả lịch sử thông báo &rarr;</a>
                            </div>
                        </div>
                    </div>

                    <div class="border-start h-50 mx-1" style="border-color: rgba(255, 255, 255, 0.1) !important;"></div>

                    <!-- User Profile Dropdown -->
                    <div class="dropdown">
                        <a href="#" class="user-profile-pill text-white" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-circle">
                                @(User.Identity.Name?.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "A")
                            </div>
                            <div class="d-none d-sm-block text-start">
                                <span class="fw-bold d-block text-white lh-1" style="font-size: 0.86rem;">@User.Identity.Name</span>
                                <span class="text-muted d-block mt-1" style="font-size: 0.7rem; font-weight: 500;">
                                    @(isBoss ? "Chủ tịch (Boss)" : "Quản trị viên (Admin)")
                                </span>
                            </div>
                            <i class="bi bi-chevron-down text-muted ms-1" style="font-size: 0.75rem;"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownUser1" style="min-width: 220px;">
                            <li class="px-3 py-2 border-bottom mb-1" style="border-color: rgba(255,255,255,0.08) !important;">
                                <div class="fw-bold text-white" style="font-size: 0.9rem;">@User.Identity.Name</div>
                                <div class="small text-muted">@(isBoss ? "Toàn quyền quản trị chuỗi hệ thống" : "Quản trị quy trình kho & đơn hàng")</div>
                            </li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" href="/"><i class="bi bi-shop text-muted"></i> Trang bán hàng cơ bản</a></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Login" asp-action="Profile"><i class="bi bi-person-badge text-muted"></i> Hồ sơ cá nhân</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 fw-semibold">
                                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main Page Body Content -->
            <div class="main-body">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Dark Notification Toasts -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 99999; margin-top: 80px;">
        @if (TempData["Success"] != null)
        {
            <div class="toast align-items-center text-white bg-dark border border-success show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 12px; background: #131d33 !important;">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                        <span>@TempData["Success"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast align-items-center text-white bg-dark border border-danger show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 12px; background: #131d33 !important;">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5 me-2"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <!-- Mobile Overlay -->
    <div class="overlay"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById('sidebar');
            const sidebarCollapse = document.getElementById('sidebarCollapse');
            const overlay = document.querySelector('.overlay');

            function toggleSidebar() {
                sidebar.classList.toggle('active');
                overlay.classList.toggle('active');
            }

            if (sidebarCollapse) sidebarCollapse.addEventListener('click', toggleSidebar);
            if (overlay) overlay.addEventListener('click', toggleSidebar);

            // Auto hide toast
            var toasts = document.querySelectorAll('.toast');
            toasts.forEach(function(toastNode) {
                var toast = new bootstrap.Toast(toastNode, { delay: 3500 });
                toast.show();
            });

            loadThongBao();
            setInterval(loadThongBao, 10000);
        });

        function loadThongBao() {
            fetch('/Admin/GetThongBao')
                .then(response => response.json())
                .then(res => {
                    if (res.success) {
                        const badge = document.getElementById('notif-badge');
                        if (res.unread > 0) {
                            badge.innerText = res.unread;
                            badge.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                        }

                        const listContainer = document.getElementById('notif-list');
                        listContainer.innerHTML = '';

                        if (res.data.length === 0) {
                            listContainer.innerHTML = '<li class="text-center text-muted py-4 small">Không có thông báo mới</li>';
                        } else {
                            res.data.forEach(item => {
                                const d = new Date(item.ngayTao);
                                const timeStr = d.getHours().toString().padStart(2, '0') + ":" + d.getMinutes().toString().padStart(2, '0');
                                const dateStr = d.getDate().toString().padStart(2, '0') + "/" + (d.getMonth() + 1).toString().padStart(2, '0') + "/" + d.getFullYear();
                                const finalDate = `${timeStr} ${dateStr}`;

                                let icon = item.loaiThongBao == 0
                                    ? '<div class="rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width:34px;height:34px;background:rgba(16,185,129,0.15);color:#34d399;"><i class="bi bi-cart-check-fill"></i></div>'
                                    : (item.loaiThongBao == 4
                                        ? '<div class="rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width:34px;height:34px;background:rgba(99,102,241,0.15);color:#818cf8;"><i class="bi bi-truck"></i></div>'
                                        : (item.loaiThongBao == 2
                                            ? '<div class="rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width:34px;height:34px;background:rgba(245,158,11,0.15);color:#fbbf24;"><i class="bi bi-arrow-repeat"></i></div>'
                                            : '<div class="rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width:34px;height:34px;background:rgba(14,165,233,0.15);color:#38bdf8;"><i class="bi bi-info-circle-fill"></i></div>'));

                                let bgClass = item.daDoc ? '' : 'bg-unread';
                                    let controllerName = item.controller ? item.controller : 'Admin';
                                    let linkUrl = item.redirectAction ? `/${controllerName}/${item.redirectAction}?highlightId=${item.redirectId}` : '/Admin/Index';

                                let html = `<li>
                                    <a class="dropdown-item d-flex align-items-start p-3 border-bottom text-wrap ${bgClass}" href="javascript:void(0)" onclick="markAndGo(${item.id}, '${linkUrl}')" style="border-color: rgba(255,255,255,0.06) !important;">
                                        ${icon}
                                        <div class="flex-grow-1 ms-1">
                                            <div class="small fw-bold text-white mb-1" style="line-height: 1.35;">${item.tieuDe ? item.tieuDe : 'Thông báo'}: ${item.noiDung}</div>
                                            <div class="text-muted" style="font-size: 11px;"><i class="bi bi-clock me-1"></i>${finalDate}</div>
                                        </div>
                                    </a>
                                </li>`;
                                listContainer.insertAdjacentHTML('beforeend', html);
                            });
                        }
                    }
                })
                .catch(err => console.log("Lỗi API thông báo:", err));
        }

        function markAndGo(id, url) {
            fetch('/Admin/MarkOneRead?id=' + id, { method: 'POST' })
                .then(() => { window.location.href = url; })
                .catch(() => { window.location.href = url; });
        }

        function danhDauDaDoc() {
            fetch('/Admin/MarkAsRead', { method: 'POST' });
            const badge = document.getElementById('notif-badge');
            if (badge) badge.classList.add('d-none');
            setTimeout(loadThongBao, 500);
        }
    </script>

    <partial name="_ChatWidget" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>