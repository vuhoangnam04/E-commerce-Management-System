@model IEnumerable<banthietbidientu.Models.LichSuHoatDong>
@{
    ViewData["Title"] = "Nhật ký hoạt động hệ thống";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h4 class="fw-bold text-primary mb-0"><i class="bi bi-journal-medical me-2"></i>Nhật Ký Hoạt Động</h4>

        <div class="d-flex align-items-center gap-2">
            <form method="get" class="d-flex gap-2">
                <select name="storeId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả chi nhánh --</option>
                    <option value="1" selected="@(ViewBag.SelectedStore == 1)">Hà Nội</option>
                    <option value="2" selected="@(ViewBag.SelectedStore == 2)">Đà Nẵng</option>
                    <option value="3" selected="@(ViewBag.SelectedStore == 3)">TP.HCM</option>
                </select>
            </form>

            @if (User.IsInRole("Boss") && Model != null && Model.Any())
            {
                <form asp-action="XoaTatCaNhatKy" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn dọn dẹp TOÀN BỘ nhật ký hoạt động hệ thống? Thao tác này không thể hoàn tác!');">
                    <button type="submit" class="btn btn-outline-danger btn-sm fw-bold text-nowrap">
                        <i class="bi bi-trash3 me-1"></i> Xóa tất cả log
                    </button>
                </form>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Thời gian</th>
                            <th>Người thực hiện</th>
                            <th>Hành động</th>
                            <th>Chi tiết nội dung</th>
                            <th>Chi nhánh</th>
                            @if (User.IsInRole("Boss"))
                            {
                                <th class="text-end pe-4">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">
                                        @item.ThoiGian.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.TenNguoiDung</div>
                                    </td>
                                    <td>
                                        @{
                                            string badgeClass = "bg-secondary";
                                            if (item.HanhDong.Contains("Thêm") || item.HanhDong.Contains("Nhập")) badgeClass = "bg-success";
                                            else if (item.HanhDong.Contains("Sửa") || item.HanhDong.Contains("Cập nhật")) badgeClass = "bg-warning text-dark";
                                            else if (item.HanhDong.Contains("Xóa") || item.HanhDong.Contains("Hủy") || item.HanhDong.Contains("Xuất")) badgeClass = "bg-danger";
                                            else if (item.HanhDong.Contains("Duyệt")) badgeClass = "bg-info text-dark";
                                        }
                                        <span class="badge @badgeClass rounded-pill">@item.HanhDong</span>
                                    </td>
                                    <td class="text-wrap" style="max-width: 400px;">
                                        @item.NoiDung
                                    </td>
                                    <td>
                                        @if (item.StoreId == 1)
                                        {
                                            <span class="badge bg-light text-secondary border">Hà Nội</span>
                                        }
                                        else if (item.StoreId == 2)
                                        {
                                            <span class="badge bg-light text-secondary border">Đà Nẵng</span>
                                        }
                                        else if (item.StoreId == 3)
                                        {
                                            <span class="badge bg-light text-secondary border">TP.HCM</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Hệ thống</span>
                                        }
                                    </td>
                                    @if (User.IsInRole("Boss"))
                                    {
                                        <td class="text-end pe-4">
                                            <form asp-action="XoaNhatKy" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa dòng nhật ký này?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm p-1 px-2" title="Xóa bản ghi này">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(User.IsInRole("Boss") ? 6 : 5)" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Chưa có ghi nhận hoạt động nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white border-0 py-3">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("NhatKyHoatDong", new { storeId = ViewBag.SelectedStore, page = currentPage - 1 })">Trước</a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("NhatKyHoatDong", new { storeId = ViewBag.SelectedStore, page = i })">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("NhatKyHoatDong", new { storeId = ViewBag.SelectedStore, page = currentPage + 1 })">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>